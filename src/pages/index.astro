---
import FormattedDate from '../components/FormattedDate.astro';
import HeroMedia from '../components/HeroMedia.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { FOCUS_AREAS, SITE_DESCRIPTION, SITE_TITLE, SITE_URL, SOCIAL_LINKS } from '../consts';
import { estimateReadingTime, getPostSlug, getSortedBlogPosts } from '../utils/blog';

const posts = (await getSortedBlogPosts()).slice(0, 3);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} includeVerification={true}>
	<script
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'Person',
			name: SITE_TITLE,
			url: SITE_URL,
			sameAs: [SOCIAL_LINKS.linkedin, SOCIAL_LINKS.github],
			jobTitle: 'Hardware Engineer',
			alumniOf: {
				'@type': 'CollegeOrUniversity',
				name: 'Nanyang Technological University',
			},
		})}
	/>

	<section class="py-14 sm:py-20">
		<p class="font-mono text-xs uppercase tracking-widest text-accent">
			Hardware · FPGAs · Computer Architecture
		</p>
		<h1 class="mt-3 max-w-2xl text-4xl font-bold tracking-tight text-foreground sm:text-5xl">
			Building fast, verifiable systems from silicon to software.
		</h1>
		<p class="mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-lg">
			I'm Ayushman Malla — a hardware engineer exploring FPGAs, CPU memory subsystems, high-level synthesis, and applied AI. Previously interned at Transcelestial, AMD, and Unilever.
		</p>
		<div class="mt-7 flex flex-wrap gap-3">
			<a
				href="/internships/"
				class="rounded-md bg-invert px-4 py-2 text-sm font-medium text-invert-foreground transition-opacity hover:opacity-90"
			>
				View Experience
			</a>
			<a
				href="/blog/"
				class="rounded-md border border-border bg-surface px-4 py-2 text-sm font-medium text-foreground transition-colors hover:border-accent"
			>
				Read Technical Notes
			</a>
		</div>
	</section>

	<section class="border-t border-border py-12">
		<h2 class="text-xl font-bold tracking-tight text-foreground sm:text-2xl">Focus Areas</h2>
		<div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
			{FOCUS_AREAS.map((area) => (
				<div class="rounded-lg border border-border bg-surface p-5">
					<p class="font-mono text-xs text-accent">{area.code}</p>
					<h3 class="mt-2 text-base font-semibold text-foreground">{area.title}</h3>
					<p class="mt-1.5 text-sm text-muted-foreground">{area.summary}</p>
				</div>
			))}
		</div>
	</section>

	<section class="border-t border-border py-12">
		<div class="flex items-baseline justify-between gap-4">
			<h2 class="text-xl font-bold tracking-tight text-foreground sm:text-2xl">Recent Writing</h2>
			<a href="/blog/" class="font-mono text-xs text-accent hover:underline">All posts →</a>
		</div>
		<ul class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2">
			{posts.map((post) => (
				<li class="overflow-hidden rounded-xl border border-border bg-surface transition-colors hover:border-accent">
					<a href={`/blog/${getPostSlug(post)}/`} class="block">
						<HeroMedia
							image={post.data.heroImage}
							alt={post.data.heroAlt ?? post.data.title}
							aspectClass="aspect-[2/1]"
						/>
						<div class="space-y-2 p-5">
							<p class="font-mono text-xs text-muted-foreground">
								<FormattedDate date={post.data.pubDate} /> · {estimateReadingTime(post.body)} min read
							</p>
							<h3 class="text-lg font-bold text-foreground">{post.data.title}</h3>
							<p class="text-sm text-muted-foreground">{post.data.description}</p>
						</div>
					</a>
				</li>
			))}
		</ul>
	</section>

	<section class="border-t border-border py-12">
		<h2 class="text-xl font-bold tracking-tight text-foreground sm:text-2xl">Get in Touch</h2>
		<p class="mt-3 max-w-xl text-sm text-muted-foreground sm:text-base">
			Always happy to talk FPGA architecture, silicon verification, low-level performance, or interesting engineering roles.
		</p>
		<div class="mt-5 flex flex-wrap gap-4 text-sm font-medium">
			<a href={SOCIAL_LINKS.email} class="text-accent hover:underline">
				{SOCIAL_LINKS.emailDisplay}
			</a>
			<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer" class="text-foreground hover:text-accent">
				GitHub ↗
			</a>
			<a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer" class="text-foreground hover:text-accent">
				LinkedIn ↗
			</a>
		</div>
	</section>
</BaseLayout>
