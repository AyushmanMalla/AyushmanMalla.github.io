---
import { Image } from 'astro:assets';
import ContoursRed from '../assets/Contours Red.png';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL, SOCIAL_LINKS } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { estimateReadingTime, getPostSlug, getSortedBlogPosts } from '../utils/blog';
import { serializeJsonLd } from '../utils/security';

const posts = (await getSortedBlogPosts()).slice(0, 3);

const EXPERIENCE_LEDGER = [
	{
		id: 'transcelestial',
		company: 'Transcelestial',
		scope: 'FPGA / 10G Ethernet',
		year: '2025',
	},
	{
		id: 'amd',
		company: 'AMD',
		scope: 'EPYC MBIST Debug',
		year: '2025',
	},
	{
		id: 'unilever',
		company: 'Unilever',
		scope: 'Risk Data Pipeline',
		year: '2024',
	},
] as const;
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} includeVerification={true}>
	<script
		slot="head"
		type="application/ld+json"
		set:html={serializeJsonLd({
			'@context': 'https://schema.org',
			'@type': 'Person',
			name: SITE_TITLE,
			url: SITE_URL,
			sameAs: [SOCIAL_LINKS.linkedin, SOCIAL_LINKS.github],
			jobTitle: 'Hardware Engineer',
			alumniOf: {
				'@type': 'CollegeOrUniversity',
				name: 'Nanyang Technological University',
			},
		})}
	/>

	<section
		class="hero-stage relative isolate overflow-hidden py-16 sm:py-24 lg:py-28"
		data-hero-stage
	>
		<div
			aria-hidden="true"
			class="hero-backdrop-feather pointer-events-none absolute inset-0"
		>
			<Image
				src={ContoursRed}
				alt=""
				aria-hidden="true"
				width={1600}
				height={900}
				loading="eager"
				decoding="sync"
				class="pointer-events-none absolute inset-0 h-full w-full object-cover object-right opacity-[0.14]"
			/>
			<div class="reveal-layer pointer-events-none absolute inset-0">
				<Image
					src={ContoursRed}
					alt=""
					aria-hidden="true"
					width={1600}
					height={900}
					loading="eager"
					decoding="sync"
					class="h-full w-full object-cover object-right opacity-85"
				/>
			</div>
			<div
				class="pointer-events-none absolute inset-0 bg-gradient-to-r from-background/90 via-background/40 to-transparent"
			/>
		</div>

		<div class="relative z-10 max-w-2xl">
			<h1 class="heading-hero font-bold text-foreground">
				Ayushman Malla<span class="text-accent">.</span>
			</h1>

			<p class="mt-6 max-w-xl text-base leading-relaxed text-foreground/85 sm:text-lg">
				Hardware engineer building fast, verifiable systems across FPGAs, CPU memory subsystems, and low-level software. Previously engineered 10G Ethernet datapaths at Transcelestial, debugged EPYC cache failures at AMD, and built risk data pipelines at Unilever.
			</p>

			<div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-2">
				<a
					href="/blog/"
					class="link-sweep min-h-[44px] py-2 text-sm font-medium text-foreground transition-colors hover:text-accent-hover focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:text-base"
				>
					<span>Selected Writing</span>
					<span aria-hidden="true" class="text-accent">→</span>
				</a>
				<a
					href="/internships/"
					class="link-sweep min-h-[44px] py-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:text-base"
				>
					<span>Experience</span>
					<span aria-hidden="true" class="text-accent">→</span>
				</a>
			</div>
		</div>
	</section>

	<section class="border-t border-border py-14 sm:py-16" aria-labelledby="experience-heading">
		<div class="flex items-baseline justify-between gap-4">
			<h2
				id="experience-heading"
				class="font-mono text-xs tracking-widest text-muted-foreground uppercase"
			>
				Selected Experience
			</h2>
			<a
				href="/internships/"
				class="link-sweep min-h-[40px] py-2 font-mono text-xs text-muted-foreground transition-colors hover:text-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
			>
				<span>Full timeline</span>
				<span aria-hidden="true" class="text-accent">→</span>
			</a>
		</div>

		<ul class="mt-6 border-b border-border">
			{EXPERIENCE_LEDGER.map((item) => (
				<li class="border-t border-border">
					<a
						href={`/internships/#${item.id}`}
						class="group grid grid-cols-1 gap-1 py-4 transition-colors focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-accent sm:grid-cols-[12rem_1fr_auto] sm:items-baseline sm:gap-6 sm:py-5"
					>
						<span class="text-base font-bold tracking-tight text-foreground transition-colors group-hover:text-accent-hover">
							{item.company}
						</span>
						<span class="text-sm text-muted-foreground transition-colors group-hover:text-foreground/85">
							{item.scope}
						</span>
						<span class="inline-flex items-center gap-2 font-mono text-xs text-muted-foreground">
							<span>{item.year}</span>
							<span
								aria-hidden="true"
								class="text-accent transition-transform duration-200 group-hover:translate-x-0.5"
							>
								→
							</span>
						</span>
					</a>
				</li>
			))}
		</ul>
	</section>

	<section class="border-t border-border py-14 sm:py-16" aria-labelledby="writing-heading">
		<div class="flex items-baseline justify-between gap-4">
			<h2
				id="writing-heading"
				class="font-mono text-xs tracking-widest text-muted-foreground uppercase"
			>
				Selected Writing
			</h2>
			<a
				href="/blog/"
				class="link-sweep min-h-[40px] py-2 font-mono text-xs text-muted-foreground transition-colors hover:text-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
			>
				<span>All posts</span>
				<span aria-hidden="true" class="text-accent">→</span>
			</a>
		</div>

		<ul class="mt-6 border-b border-border">
			{posts.map((post) => (
				<li class="border-t border-border">
					<a
						href={`/blog/${getPostSlug(post)}/`}
						data-hover-video-trigger
						class="group flex flex-col gap-5 py-7 transition-colors focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-accent sm:flex-row sm:items-center sm:justify-between sm:gap-8 sm:py-8"
					>
						<div class="min-w-0 flex-1 space-y-2">
							<p class="font-mono text-xs text-muted-foreground">
								<FormattedDate date={post.data.pubDate} /> · {estimateReadingTime(post.body)} min read
							</p>
							<h3 class="text-lg font-bold tracking-tight text-foreground transition-colors group-hover:text-accent-hover sm:text-xl">
								{post.data.title}
							</h3>
							<p class="line-clamp-2 text-sm leading-relaxed text-muted-foreground sm:line-clamp-1">
								{post.data.description}
							</p>
						</div>

						{(post.data.heroVideo || post.data.heroImage) && (
							<div class="aspect-[2/1] w-full shrink-0 overflow-hidden rounded-lg border border-border/70 bg-surface-subtle transition-colors group-hover:border-accent/45 sm:w-56">
								{post.data.heroVideo ? (
									<video
										src={post.data.heroVideo}
										poster={post.data.heroImage?.src}
										muted
										playsinline
										loop
										preload="metadata"
										aria-hidden="true"
										data-hover-video
										class="h-full w-full object-cover"
									>
										<source
											src={post.data.heroVideo}
											type={post.data.heroVideo.endsWith('.webm') ? 'video/webm' : 'video/mp4'}
										/>
									</video>
								) : (
									post.data.heroImage && (
										<Image
											src={post.data.heroImage}
											alt={post.data.heroAlt ?? post.data.title}
											width={640}
											height={320}
											loading="lazy"
											decoding="async"
											class="h-full w-full object-cover"
										/>
									)
								)}
							</div>
						)}
					</a>
				</li>
			))}
		</ul>
	</section>

	<section class="border-t border-border py-14 sm:py-16" aria-labelledby="contact-heading">
		<h2
			id="contact-heading"
			class="font-mono text-xs tracking-widest text-muted-foreground uppercase"
		>
			Contact
		</h2>
		<p class="mt-4 max-w-xl text-sm leading-relaxed text-muted-foreground sm:text-base">
			Always happy to talk FPGA architecture, silicon verification, low-level performance, or interesting roles.
		</p>

		<div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
			<button
				type="button"
				data-copy-email
				data-email={SOCIAL_LINKS.emailDisplay}
				class="group inline-flex min-h-[44px] cursor-pointer items-center gap-2.5 border-b border-border py-2 font-mono text-xs text-foreground transition-colors hover:border-accent hover:text-accent-hover focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:text-sm"
			>
				<span>{SOCIAL_LINKS.emailDisplay}</span>
				<span
					data-copy-status
					aria-live="polite"
					class="text-xs text-muted-foreground transition-colors group-hover:text-accent"
				>
					Copy
				</span>
			</button>

			<div class="flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-xs sm:text-sm">
				<a
					href={SOCIAL_LINKS.email}
					class="inline-flex min-h-[44px] items-center py-2 text-muted-foreground transition-colors hover:text-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
				>
					Email ↗
				</a>
				<a
					href={SOCIAL_LINKS.github}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex min-h-[44px] items-center py-2 text-muted-foreground transition-colors hover:text-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
				>
					GitHub ↗
				</a>
				<a
					href={SOCIAL_LINKS.linkedin}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex min-h-[44px] items-center py-2 text-muted-foreground transition-colors hover:text-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
				>
					LinkedIn ↗
				</a>
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	function initHeroReveal() {
		const stage = document.querySelector<HTMLElement>('[data-hero-stage]');
		if (!stage || stage.dataset.revealBound === 'true') return;
		stage.dataset.revealBound = 'true';

		let rect = stage.getBoundingClientRect();
		const updateRect = () => {
			rect = stage.getBoundingClientRect();
		};

		const resizeObserver = new ResizeObserver(updateRect);
		resizeObserver.observe(stage);
		window.addEventListener('scroll', updateRect, { passive: true });
		stage.addEventListener('pointerenter', updateRect);

		stage.addEventListener('pointermove', (event) => {
			if (!rect.width || !rect.height) return;
			const x = ((event.clientX - rect.left) / rect.width) * 100;
			const y = ((event.clientY - rect.top) / rect.height) * 100;
			stage.style.setProperty('--mx', `${x}%`);
			stage.style.setProperty('--my', `${y}%`);
		});
	}

	function initHoverVideos() {
		const allowMotion = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
		if (!allowMotion) return;

		document.querySelectorAll<HTMLElement>('[data-hover-video-trigger]').forEach((trigger) => {
			if (trigger.dataset.hoverBound === 'true') return;
			trigger.dataset.hoverBound = 'true';

			const video = trigger.querySelector<HTMLVideoElement>('[data-hover-video]');
			if (!video) return;

			const playVideo = () => {
				video.play().catch(() => {});
			};
			const pauseVideo = () => {
				video.pause();
			};

			trigger.addEventListener('pointerenter', (event) => {
				if (event.pointerType === 'touch') return;
				playVideo();
			});
			trigger.addEventListener('pointerleave', pauseVideo);
			trigger.addEventListener('focusin', playVideo);
			trigger.addEventListener('focusout', pauseVideo);
		});
	}

	async function copyTextSafe(text: string) {
		try {
			if (navigator.clipboard && window.isSecureContext) {
				await navigator.clipboard.writeText(text);
				return true;
			}
		} catch {
			// Clipboard API unavailable or blocked in this context
		}
		return false;
	}

	function initCopyEmail() {
		document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((button) => {
			if (button.dataset.copyBound === 'true') return;
			button.dataset.copyBound = 'true';

			const status = button.querySelector<HTMLElement>('[data-copy-status]');
			const email = button.dataset.email ?? '';
			let timer: number | undefined;

			button.addEventListener('click', async () => {
				if (!email) return;
				await copyTextSafe(email);
				if (status) {
					status.textContent = 'Copied ✓';
					status.classList.remove('text-muted-foreground');
					status.classList.add('text-accent');
				}
				button.dataset.copied = 'true';
				window.clearTimeout(timer);
				timer = window.setTimeout(() => {
					if (status) {
						status.textContent = 'Copy';
						status.classList.remove('text-accent');
						status.classList.add('text-muted-foreground');
					}
					delete button.dataset.copied;
				}, 2200);
			});
		});
	}

	function initHome() {
		initHeroReveal();
		initHoverVideos();
		initCopyEmail();
	}

	initHome();
	document.addEventListener('astro:after-swap', initHome);
</script>
