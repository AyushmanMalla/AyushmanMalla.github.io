---
import { Image } from 'astro:assets';
import ContoursRed from '../assets/Contours Red.png';
import FormattedDate from '../components/FormattedDate.astro';
import HeroMedia from '../components/HeroMedia.astro';
import { FOCUS_AREAS, SITE_DESCRIPTION, SITE_TITLE, SITE_URL, SOCIAL_LINKS } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { estimateReadingTime, getPostSlug, getSortedBlogPosts } from '../utils/blog';

const posts = (await getSortedBlogPosts()).slice(0, 3);

const DISCIPLINES = [
	'FPGA Design',
	'Computer Architecture',
	'Silicon Verification',
	'Applied AI',
] as const;
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} includeVerification={true}>
	<script
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'Person',
			name: SITE_TITLE,
			url: SITE_URL,
			sameAs: [SOCIAL_LINKS.linkedin, SOCIAL_LINKS.github],
			jobTitle: 'Hardware Engineer',
			alumniOf: {
				'@type': 'CollegeOrUniversity',
				name: 'Nanyang Technological University',
			},
		})}
	/>

	<section class="pt-8 pb-12 sm:pt-12 sm:pb-16">
		<div class="relative overflow-hidden rounded-2xl border border-border bg-surface">
			<Image
				src={ContoursRed}
				alt=""
				aria-hidden="true"
				width={1600}
				height={900}
				loading="eager"
				decoding="sync"
				class="pointer-events-none absolute inset-0 h-full w-full object-cover object-right opacity-75"
			/>
			<div
				aria-hidden="true"
				class="pointer-events-none absolute inset-0 bg-gradient-to-r from-background via-background/88 to-background/20"
			/>
			<div
				aria-hidden="true"
				class="pointer-events-none absolute inset-0 bg-gradient-to-t from-background/80 via-transparent to-background/25"
			/>

			<div class="relative z-10 px-6 py-11 sm:px-10 sm:py-16 lg:px-12 lg:py-20">
				<p class="inline-flex items-center gap-2 font-mono text-xs tracking-widest text-accent uppercase">
					<span aria-hidden="true" class="inline-block h-2 w-2 rounded-[2px] bg-accent" />
					<span>Hardware &amp; Systems Engineer</span>
				</p>

				<h1 class="heading-hero mt-4 max-w-2xl font-bold text-foreground">
					Hi, I'm Ayushman Malla<span class="text-accent">.</span>
				</h1>

				<p class="mt-5 max-w-2xl text-base leading-relaxed text-foreground/85 sm:text-lg">
					Building fast, verifiable systems from silicon to software — spanning 10G Ethernet FPGA pipelines, enterprise CPU cache debug, high-level synthesis, and applied AI. Previously interned at Transcelestial, AMD, and Unilever.
				</p>

				<ul class="mt-6 flex flex-wrap gap-2.5" aria-label="Core disciplines">
					{DISCIPLINES.map((item) => (
						<li class="inline-flex items-center gap-2 rounded-md border border-border bg-background/85 px-3 py-1.5 font-mono text-xs text-foreground/95 backdrop-blur-xs">
							<span aria-hidden="true" class="inline-block h-1.5 w-1.5 rounded-[1px] bg-accent" />
							<span>{item}</span>
						</li>
					))}
				</ul>

				<div class="mt-8 flex flex-wrap items-center gap-3.5">
					<a
						href="/internships/"
						class="inline-flex min-h-[44px] items-center gap-2 rounded-lg bg-accent px-5 py-2.5 text-sm font-bold text-accent-foreground transition-colors hover:bg-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
					>
						<span>Explore Experience</span>
						<span aria-hidden="true">→</span>
					</a>
					<a
						href="/blog/"
						class="inline-flex min-h-[44px] items-center gap-2 rounded-lg border border-border bg-background/85 px-5 py-2.5 text-sm font-medium text-foreground backdrop-blur-xs transition-colors hover:border-accent hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
					>
						<span>Read Blog</span>
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="border-t border-border py-12">
		<div class="flex flex-col gap-1">
			<p class="font-mono text-xs tracking-widest text-accent uppercase">Disciplines</p>
			<h2 class="heading-section font-bold text-foreground">Focus Areas</h2>
		</div>

		<div class="mt-7 grid grid-cols-1 gap-4 sm:grid-cols-2">
			{FOCUS_AREAS.map((area) => (
				<div class="rounded-xl border border-border bg-surface p-5 sm:p-6">
					<div class="flex items-center gap-2.5">
						<span class="font-mono text-xs font-semibold text-accent">{area.code}</span>
						<span class="h-px flex-1 bg-border" aria-hidden="true" />
					</div>
					<h3 class="mt-3 text-base font-bold text-foreground sm:text-lg">{area.title}</h3>
					<p class="mt-2 text-sm leading-relaxed text-muted-foreground">{area.summary}</p>
				</div>
			))}
		</div>
	</section>

	<section class="border-t border-border py-12">
		<div class="flex flex-wrap items-end justify-between gap-4">
			<div class="flex flex-col gap-1">
				<p class="font-mono text-xs tracking-widest text-accent uppercase">Notes &amp; Deep Dives</p>
				<h2 class="heading-section font-bold text-foreground">Recent Blog Posts</h2>
			</div>
			<a
				href="/blog/"
				class="inline-flex items-center gap-1.5 font-mono text-xs text-accent transition-colors hover:text-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
			>
				<span>All posts</span>
				<span aria-hidden="true">→</span>
			</a>
		</div>

		<ul class="mt-7 grid grid-cols-1 gap-6 md:grid-cols-2">
			{posts.map((post) => (
				<li class="card-lift group overflow-hidden rounded-2xl border border-border bg-surface">
					<a
						href={`/blog/${getPostSlug(post)}/`}
						class="flex h-full flex-col focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-accent"
					>
						<HeroMedia
							image={post.data.heroImage}
							alt={post.data.heroAlt ?? post.data.title}
							aspectClass="aspect-[2/1]"
							class="border-b border-border"
						/>
						<div class="flex flex-1 flex-col gap-2.5 p-5 sm:p-6">
							<p class="font-mono text-xs text-muted-foreground">
								<FormattedDate date={post.data.pubDate} /> · {estimateReadingTime(post.body)} min read
							</p>
							<h3 class="text-lg font-bold tracking-tight text-foreground transition-colors group-hover:text-accent-hover sm:text-xl">
								{post.data.title}
							</h3>
							<p class="text-sm leading-relaxed text-muted-foreground">
								{post.data.description}
							</p>
							{post.data.tags.length > 0 && (
								<div class="mt-auto flex flex-wrap gap-1.5 pt-3">
									{post.data.tags.map((tag) => (
										<span class="rounded border border-border bg-surface-subtle px-2 py-0.5 font-mono text-[11px] text-muted-foreground">
											{tag}
										</span>
									))}
								</div>
							)}
						</div>
					</a>
				</li>
			))}
		</ul>
	</section>

	<section class="pt-4 pb-4">
		<div class="rounded-2xl border border-border bg-surface p-6 sm:p-9 lg:p-10">
			<div class="h-[2px] w-14 bg-accent" aria-hidden="true" />
			<div class="mt-5 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
				<div class="max-w-xl">
					<h2 class="heading-section font-bold text-foreground">Get in Touch</h2>
					<p class="mt-2.5 text-sm leading-relaxed text-muted-foreground sm:text-base">
						Always happy to talk FPGA architecture, silicon verification, low-level performance engineering, or interesting roles and collaborations.
					</p>
				</div>

				<div class="flex flex-col items-start gap-3 lg:items-end">
					<a
						href={SOCIAL_LINKS.email}
						class="inline-flex min-h-[44px] items-center gap-2 rounded-lg bg-accent px-4 py-2.5 font-mono text-xs font-medium text-accent-foreground transition-colors hover:bg-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:text-sm"
					>
						<span>{SOCIAL_LINKS.emailDisplay}</span>
					</a>
					<div class="flex flex-wrap items-center gap-3">
						<a
							href={SOCIAL_LINKS.github}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex min-h-[44px] items-center gap-1.5 rounded-lg border border-border bg-background px-4 py-2.5 font-mono text-xs text-foreground transition-colors hover:border-accent hover:text-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:text-sm"
						>
							<span>GitHub</span>
							<span aria-hidden="true">↗</span>
						</a>
						<a
							href={SOCIAL_LINKS.linkedin}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex min-h-[44px] items-center gap-1.5 rounded-lg border border-border bg-background px-4 py-2.5 font-mono text-xs text-foreground transition-colors hover:border-accent hover:text-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:text-sm"
						>
							<span>LinkedIn</span>
							<span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
