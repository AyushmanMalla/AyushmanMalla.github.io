---
import FormattedDate from '../../components/FormattedDate.astro';
import HeroMedia from '../../components/HeroMedia.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { estimateReadingTime, getPostSlug, getSortedBlogPosts } from '../../utils/blog';

const posts = await getSortedBlogPosts();
---

<BaseLayout
	title="Blog"
	description="Technical deep dives on CPU architecture, branch prediction, cache locality, FPGAs, and systems performance."
>
	<section class="py-12">
		<h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-5xl">Writing</h1>
		<p class="mt-3 max-w-2xl text-base text-muted-foreground">
			Technical breakdowns on hardware behavior, microarchitecture, and performance engineering.
		</p>

		<ul class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
			{posts.map((post) => (
				<li class="overflow-hidden rounded-xl border border-border bg-surface transition-colors hover:border-accent">
					<a href={`/blog/${getPostSlug(post)}/`} class="block">
						<HeroMedia
							image={post.data.heroImage}
							alt={post.data.heroAlt ?? post.data.title}
							aspectClass="aspect-[2/1]"
						/>
						<div class="space-y-2 p-5">
							<p class="font-mono text-xs text-muted-foreground">
								<FormattedDate date={post.data.pubDate} /> · {estimateReadingTime(post.body)} min read
							</p>
							<h2 class="text-xl font-bold text-foreground">{post.data.title}</h2>
							<p class="text-sm text-muted-foreground">{post.data.description}</p>
						</div>
					</a>
				</li>
			))}
		</ul>
	</section>
</BaseLayout>
