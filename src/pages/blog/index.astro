---
import FormattedDate from '../../components/FormattedDate.astro';
import HeroMedia from '../../components/HeroMedia.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { estimateReadingTime, getPostSlug, getSortedBlogPosts } from '../../utils/blog';

const posts = await getSortedBlogPosts();
const [featuredPost, ...otherPosts] = posts;
---

<BaseLayout
	title="Blog"
	description="Technical deep dives on CPU architecture, branch prediction, cache locality, FPGAs, and systems performance."
>
	<section class="py-10 sm:py-14">
		<div class="max-w-2xl">
			<p class="inline-flex items-center gap-2 font-mono text-xs tracking-widest text-accent uppercase">
				<span aria-hidden="true" class="inline-block h-2 w-2 rounded-[2px] bg-accent" />
				<span>Notes &amp; Deep Dives</span>
			</p>
			<h1 class="heading-page mt-3 font-bold text-foreground">Writing</h1>
			<p class="mt-3 text-base leading-relaxed text-muted-foreground sm:text-lg">
				Technical breakdowns on hardware behavior, CPU microarchitecture, and performance engineering.
			</p>
		</div>

		<div class="mt-8 flex items-center gap-3" aria-hidden="true">
			<span class="h-[2px] w-12 bg-accent" />
			<span class="h-px flex-1 bg-border" />
		</div>

		<div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-2">
			{featuredPost && (
				<article class="card-lift group relative overflow-hidden rounded-2xl border border-border bg-surface lg:col-span-2">
					<div class="grid grid-cols-1 lg:grid-cols-12">
						<div class="lg:col-span-7">
							<HeroMedia
								image={featuredPost.data.heroImage}
								video={featuredPost.data.heroVideo}
								alt={featuredPost.data.heroAlt ?? featuredPost.data.title}
								aspectClass="aspect-[2/1]"
								class="h-full border-b border-border lg:border-r lg:border-b-0"
								priority={true}
							/>
						</div>

						<div class="flex flex-col justify-between gap-4 p-6 sm:p-8 lg:col-span-5">
							<div class="space-y-3">
								<div class="flex flex-wrap items-center gap-2.5 font-mono text-xs">
									<span class="rounded bg-accent-soft px-2 py-0.5 font-semibold text-accent">
										LATEST
									</span>
									<span class="text-muted-foreground">
										<FormattedDate date={featuredPost.data.pubDate} /> · {estimateReadingTime(featuredPost.body)} min read
									</span>
								</div>

								<h2 class="text-2xl font-bold tracking-tight text-foreground transition-colors group-hover:text-accent-hover sm:text-3xl">
									<a
										href={`/blog/${getPostSlug(featuredPost)}/`}
										class="after:absolute after:inset-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
									>
										{featuredPost.data.title}
									</a>
								</h2>

								<p class="text-sm leading-relaxed text-muted-foreground sm:text-base">
									{featuredPost.data.description}
								</p>
							</div>

							<div class="space-y-4 pt-2">
								{featuredPost.data.tags.length > 0 && (
									<ul class="flex flex-wrap gap-2" aria-label="Post topics">
										{featuredPost.data.tags.map((tag) => (
											<li class="rounded border border-border bg-surface-subtle px-2.5 py-0.5 font-mono text-xs text-muted-foreground">
												{tag}
											</li>
										))}
									</ul>
								)}
								<p class="inline-flex items-center gap-1.5 font-mono text-xs font-medium text-accent transition-colors group-hover:text-accent-hover">
									<span>Read article</span>
									<span aria-hidden="true">→</span>
								</p>
							</div>
						</div>
					</div>
				</article>
			)}

			{otherPosts.map((post) => (
				<article class="card-lift group overflow-hidden rounded-2xl border border-border bg-surface">
					<a
						href={`/blog/${getPostSlug(post)}/`}
						class="flex h-full flex-col focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-accent"
					>
						<HeroMedia
							image={post.data.heroImage}
							alt={post.data.heroAlt ?? post.data.title}
							aspectClass="aspect-[2/1]"
							class="border-b border-border"
						/>
						<div class="flex flex-1 flex-col gap-2.5 p-6">
							<p class="font-mono text-xs text-muted-foreground">
								<FormattedDate date={post.data.pubDate} /> · {estimateReadingTime(post.body)} min read
							</p>
							<h2 class="text-xl font-bold tracking-tight text-foreground transition-colors group-hover:text-accent-hover sm:text-2xl">
								{post.data.title}
							</h2>
							<p class="text-sm leading-relaxed text-muted-foreground">
								{post.data.description}
							</p>
							{post.data.tags.length > 0 && (
								<div class="mt-auto flex flex-wrap gap-1.5 pt-3">
									{post.data.tags.map((tag) => (
										<span class="rounded border border-border bg-surface-subtle px-2 py-0.5 font-mono text-[11px] text-muted-foreground">
											{tag}
										</span>
									))}
								</div>
							)}
						</div>
					</a>
				</article>
			))}
		</div>
	</section>
</BaseLayout>
