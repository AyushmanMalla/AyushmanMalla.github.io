---
import InternshipCard from '../components/InternshipCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { INTERNSHIPS } from '../data/experience';
---

<BaseLayout
	title="Internships"
	description="Professional hardware, FPGA, and systems engineering internship experience at Transcelestial, AMD, and Unilever."
>
	<section class="py-12">
		<h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-5xl">
			Professional Experience
		</h1>
		<p class="mt-3 max-w-2xl text-base text-muted-foreground">
			Hands-on work across 10G Ethernet FPGA pipelines, enterprise CPU cache debug, and supply-chain data systems.
		</p>

		<div class="mt-10 space-y-8">
			{INTERNSHIPS.map((internship) => (
				<InternshipCard internship={internship} />
			))}
		</div>
	</section>
</BaseLayout>
