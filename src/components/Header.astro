---
import { NAV_LINKS, SITE_TITLE } from '../consts';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-border bg-background/90 backdrop-blur-md">
	<nav
		aria-label="Primary navigation"
		class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6"
	>
		<a
			href="/"
			class="text-base font-semibold tracking-tight text-foreground transition-colors hover:text-accent"
		>
			{SITE_TITLE}
		</a>
		<ul class="flex items-center gap-5 sm:gap-7">
			{NAV_LINKS.map((item) => (
				<li>
					<a
						href={item.href}
						aria-current={isActive(item.href) ? 'page' : undefined}
						class:list={[
							'text-sm transition-colors hover:text-foreground',
							isActive(item.href) ? 'font-semibold text-accent' : 'text-muted-foreground',
						]}
					>
						{item.label}
					</a>
				</li>
			))}
		</ul>
	</nav>
</header>
