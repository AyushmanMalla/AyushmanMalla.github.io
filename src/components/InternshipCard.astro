---
import { Image } from 'astro:assets';
import type { Internship } from '../data/experience';

interface Props {
	internship: Internship;
}

const { internship } = Astro.props;
const aspectClass = internship.aspectHint === 'wide' ? 'aspect-[21/9]' : 'aspect-video';
---

<article class="grid grid-cols-1 items-start gap-6 rounded-xl border border-border bg-surface p-5 sm:p-7 lg:grid-cols-12 lg:gap-8">
	<div class="lg:col-span-5">
		<div class:list={['w-full overflow-hidden rounded-lg border border-border bg-surface-subtle', aspectClass]}>
			<Image
				src={internship.graphic}
				alt={internship.graphicAlt}
				width={960}
				height={540}
				class="h-full w-full object-cover"
			/>
		</div>
	</div>

	<div class="space-y-4 lg:col-span-7">
		<div class="flex flex-wrap items-baseline justify-between gap-2">
			<div>
				<h2 class="text-2xl font-bold tracking-tight text-foreground">{internship.company}</h2>
				<p class="text-base font-medium text-accent">{internship.role}</p>
			</div>
			<p class="font-mono text-xs text-muted-foreground">
				{internship.period} · {internship.location}
			</p>
		</div>

		<ul class="flex flex-wrap gap-2">
			{internship.highlights.map((tag) => (
				<li class="rounded-md border border-border bg-surface-subtle px-2.5 py-0.5 font-mono text-xs text-muted-foreground">
					{tag}
				</li>
			))}
		</ul>

		<div class="space-y-3 text-sm leading-relaxed text-muted-foreground sm:text-base">
			{internship.paragraphs.map((paragraph) => (
				<p>{paragraph}</p>
			))}
		</div>
	</div>
</article>
