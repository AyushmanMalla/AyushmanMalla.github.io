---
import { Image } from 'astro:assets';
import type { Internship } from '../data/experience';

interface Props {
	internship: Internship;
	index: number;
}

const { internship, index } = Astro.props;
const isReversed = index % 2 === 1;
const timelineNumber = String(index + 1).padStart(2, '0');
const aspectClass = internship.aspectHint === 'wide' ? 'aspect-[21/9]' : 'aspect-video';
const imgWidth = internship.aspectHint === 'wide' ? 1260 : 960;
const imgHeight = internship.aspectHint === 'wide' ? 540 : 540;
---

<article id={internship.id} class="scroll-mt-24 border-t border-border pt-10 sm:pt-12">
	<div class="mb-6 flex flex-wrap items-center justify-between gap-2 font-mono text-xs text-muted-foreground">
		<div class="flex items-center gap-2.5">
			<span class="font-semibold text-accent">{timelineNumber}</span>
			<span class="text-border" aria-hidden="true">/</span>
			<span>{internship.domain}</span>
		</div>
		<span>
			{internship.period} · {internship.location}
		</span>
	</div>

	<div class="grid grid-cols-1 items-start gap-7 md:grid-cols-12 md:gap-10">
		<div
			class:list={[
				'md:col-span-5',
				isReversed ? 'md:order-last' : 'md:order-first',
			]}
		>
			<div
				class:list={[
					'w-full overflow-hidden rounded-xl border border-border/80 bg-surface-subtle',
					aspectClass,
				]}
			>
				<Image
					src={internship.graphic}
					alt={internship.graphicAlt}
					width={imgWidth}
					height={imgHeight}
					class="h-full w-full object-cover"
				/>
			</div>
		</div>

		<div class="space-y-4 md:col-span-7">
			<div>
				<h2 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
					{internship.company}
				</h2>
				<p class="mt-1 text-base font-medium text-accent">{internship.role}</p>
			</div>

			<p
				class="font-mono text-xs leading-relaxed text-muted-foreground"
				aria-label={`${internship.company} technical scope`}
			>
				{internship.highlights.join(' · ')}
			</p>

			<div class="space-y-3.5 text-sm leading-relaxed text-foreground/80 sm:text-base">
				{internship.paragraphs.map((paragraph) => (
					<p>{paragraph}</p>
				))}
			</div>
		</div>
	</div>
</article>
